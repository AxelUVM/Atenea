{
  "tasks": {
    "start": "deno run --env-file --allow-net --allow-env --allow-read --allow-write=responses main.ts",
    "dev": "deno run --watch --env-file --allow-net --allow-env --allow-read=.env --allow-write=responses --allow-read main.ts",
    "test": "deno test --allow-read --allow-write --allow-env"
  },
  "imports": {
    "@google/genai": "npm:@google/genai@^1",
    "@std/assert": "jsr:@std/assert@^1"
  }
}
